APP_NAME="NSAPI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notifications
DB_USERNAME=ns_user
DB_PASSWORD=secret

# Test database (used by PHPUnit)
DB_TEST_DATABASE=notifications_test

QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ns_rabbit
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_DRIVER=redis
SESSION_DRIVER=redis

NGINX_PORT=8080

# Idempotency key TTL in seconds (default: 24 hours)
IDEMPOTENCY_TTL=86400

# Max retry attempts for failed jobs
QUEUE_MAX_TRIES=3
