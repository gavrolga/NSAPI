{
    "openapi": "3.0.0",
    "info": {
        "title": "Notification Service API",
        "description": "Микросервис массовых уведомлений",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "paths": {
        "/notifications": {
            "post": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Запустить массовую рассылку",
                "operationId": "45fac1f022f5030b5d6665731972cb12",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "channel",
                                    "message",
                                    "idempotency_key",
                                    "recipient_ids"
                                ],
                                "properties": {
                                    "channel": {
                                        "type": "string",
                                        "example": "email",
                                        "enum": [
                                            "email",
                                            "sms"
                                        ]
                                    },
                                    "message": {
                                        "type": "string",
                                        "example": "Ваш код: 1234"
                                    },
                                    "priority": {
                                        "type": "string",
                                        "example": "high",
                                        "enum": [
                                            "high",
                                            "low"
                                        ]
                                    },
                                    "idempotency_key": {
                                        "type": "string",
                                        "example": "unique-key-001"
                                    },
                                    "recipient_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "example": [
                                            1,
                                            2,
                                            3
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Уведомление принято в очередь",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "notification_id": {
                                            "type": "string"
                                        },
                                        "channel": {
                                            "type": "string"
                                        },
                                        "priority": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "recipients_count": {
                                            "type": "integer"
                                        },
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Дубликат запроса"
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                }
            }
        },
        "/subscribers/{id}/notifications": {
            "get": {
                "tags": [
                    "Subscribers"
                ],
                "summary": "История уведомлений подписчика",
                "operationId": "1a3c86665b00845d117affc36fb56520",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список уведомлений"
                    },
                    "404": {
                        "description": "Подписчик не найден"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Notifications",
            "description": "Notifications"
        },
        {
            "name": "Subscribers",
            "description": "Subscribers"
        }
    ]
}