{
  "info": {
    "name": "Notification Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Send Bulk Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"email\",\n  \"message\": \"Ваш код доступа: 1234\",\n  \"priority\": \"high\",\n  \"idempotency_key\": \"unique-key-001\",\n  \"recipient_ids\": [1, 2, 3]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/notifications",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "notifications"]
        }
      }
    },
    {
      "name": "Send SMS Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"sms\",\n  \"message\": \"Ваш маршрут изменён\",\n  \"priority\": \"high\",\n  \"idempotency_key\": \"unique-key-002\",\n  \"recipient_ids\": [1, 2]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/notifications",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "notifications"]
        }
      }
    },
    {
      "name": "Get Subscriber Notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/subscribers/1/notifications",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "subscribers", "1", "notifications"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ]
}
